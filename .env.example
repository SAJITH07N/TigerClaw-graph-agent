# ==============================================================================
# TigerGraph Agentic Fraud Investigation & Next-Best Action Environment Config
# ==============================================================================

# TigerGraph Savanna Cloud / Local Docker Endpoint
# (Leave empty or default to use the built-in High-Fidelity In-Memory Engine)
TIGERGRAPH_HOST=http://127.0.0.1
TIGERGRAPH_PORT=14240
TIGERGRAPH_RESTPP_PORT=9000
TIGERGRAPH_GRAPHNAME=FraudGraph
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=tigergraph
TIGERGRAPH_SECRET=
TIGERGRAPH_API_TOKEN=

# Mode: 'auto', 'live', or 'in_memory'
TIGERGRAPH_MODE=auto

# Server & Dashboard Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Optional Groq Cloud LLM API for Dynamic Investigation Narratives
# (Free API key from https://console.groq.com - falls back gracefully to local GraphRAG templates if omitted)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Financial Institution Metadata
INSTITUTION_NAME=First Global Bank, N.A.
BSA_ID=BSA-99482-TX
