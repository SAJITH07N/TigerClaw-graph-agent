// ============================================================================
// TigerGraph Fraud Investigation & Next-Best Action Schema DDL
// Defines 14 Vertices and 10+ Edges for Fraud Investigation, GraphRAG & Case Memory
// ============================================================================

CREATE GRAPH FraudInvestigationGraph()

// ----------------------------------------------------------------------------
// Vertices
// ----------------------------------------------------------------------------
CREATE SCHEMA_CHANGE JOB change_schema_for_fraud_graph FOR GRAPH FraudInvestigationGraph {
    // 1. Transaction Entity
    ADD VERTEX Transaction(
        PRIMARY_ID txn_id STRING,
        amount DOUBLE,
        ts INT,
        product_cd STRING,
        risk_score DOUBLE,
        is_fraud INT,
        addr1 STRING,
        addr2 STRING,
        dist1 DOUBLE,
        dist2 DOUBLE,
        p_emaildomain STRING,
        r_emaildomain STRING
    ) WITH STATS="OUTDEGREE_BY_EDGETYPE";

    // 2. Identity Entity
    ADD VERTEX Identity(
        PRIMARY_ID identity_id STRING,
        device_type STRING,
        device_info STRING,
        id_1 STRING,
        id_2 STRING,
        id_30 STRING,
        id_31 STRING,
        id_33 STRING
    );

    // 3. Card Entity
    ADD VERTEX Card(
        PRIMARY_ID card_id STRING,
        card1 STRING,
        card2 STRING,
        card3 STRING,
        card4 STRING,
        card5 STRING,
        card6 STRING,
        is_compromised BOOL DEFAULT false
    );

    // 4. Account Proxy Entity (Clustered by card + addr1 + email)
    ADD VERTEX Account(
        PRIMARY_ID account_id STRING,
        account_holder_name STRING,
        tenure_months INT,
        historical_avg_amount DOUBLE,
        historical_velocity DOUBLE,
        kyc_status STRING,
        risk_score DOUBLE DEFAULT 0.1
    );

    // 5. Device Entity
    ADD VERTEX Device(
        PRIMARY_ID device_id STRING,
        device_fingerprint STRING,
        os STRING,
        browser STRING,
        is_emulator BOOL DEFAULT false,
        risk_score DOUBLE DEFAULT 0.1
    );

    // 6. Address Entity
    ADD VERTEX Address(
        PRIMARY_ID addr_id STRING,
        zip_code STRING,
        country STRING,
        region STRING
    );

    // 7. Email Domain Entity
    ADD VERTEX EmailDomain(
        PRIMARY_ID domain_name STRING,
        is_disposable BOOL DEFAULT false
    );

    // 8. Case Entity (Audit & Memory)
    ADD VERTEX Case(
        PRIMARY_ID case_id STRING,
        status STRING,
        risk_level STRING,
        confidence_score DOUBLE,
        fraud_type_hypothesis STRING,
        opened_at INT,
        closed_at INT,
        summary_embedding LIST<DOUBLE>
    );

    // 9. Evidence Entity
    ADD VERTEX Evidence(
        PRIMARY_ID evidence_id STRING,
        evidence_type STRING,
        source_ref STRING,
        content STRING,
        score_contribution DOUBLE,
        added_at INT
    );

    // 10. Decision Entity
    ADD VERTEX Decision(
        PRIMARY_ID decision_id STRING,
        decision_type STRING,
        rationale STRING,
        actor STRING,
        ts INT
    );

    // 11. Action Entity
    ADD VERTEX Action(
        PRIMARY_ID action_id STRING,
        action_type STRING,
        status STRING,
        approval_route STRING,
        executed_at INT
    );

    // 12. Policy Document Entity (GraphRAG)
    ADD VERTEX PolicyDoc(
        PRIMARY_ID policy_id STRING,
        title STRING,
        clause_id STRING,
        text_content STRING,
        embedding LIST<DOUBLE>
    );

    // 13. Typology Document Entity (GraphRAG)
    ADD VERTEX TypologyDoc(
        PRIMARY_ID typology_id STRING,
        name STRING,
        description STRING,
        indicators LIST<STRING>,
        embedding LIST<DOUBLE>
    );

    // 14. Prior Closed Case Entity (Historical Memory Layer)
    ADD VERTEX PriorCase(
        PRIMARY_ID prior_case_id STRING,
        outcome STRING,
        confirmed_fraud BOOL,
        fraud_type STRING,
        summary STRING,
        embedding LIST<DOUBLE>
    );

    // ------------------------------------------------------------------------
    // Edges
    // ------------------------------------------------------------------------
    ADD UNDIRECTED EDGE PAID_WITH(FROM Transaction, TO Card);
    ADD UNDIRECTED EDGE FROM_DEVICE(FROM Transaction, TO Device);
    ADD UNDIRECTED EDGE TO_ADDRESS(FROM Transaction, TO Address);
    ADD UNDIRECTED EDGE HELD_BY(FROM Card, TO Account);
    ADD UNDIRECTED EDGE USED_BY(FROM Device, TO Account);
    ADD UNDIRECTED EDGE SHARES_DEVICE(FROM Account, TO Device, weight DOUBLE);
    ADD UNDIRECTED EDGE SHARES_CARD(FROM Account, TO Card, weight DOUBLE);

    ADD DIRECTED EDGE ABOUT_ACCOUNT(FROM Case, TO Account);
    ADD DIRECTED EDGE ABOUT_TRANSACTION(FROM Case, TO Transaction);
    ADD DIRECTED EDGE HAS_EVIDENCE(FROM Case, TO Evidence);
    ADD DIRECTED EDGE HAS_DECISION(FROM Case, TO Decision);
    ADD DIRECTED EDGE LED_TO(FROM Decision, TO Action);
    ADD DIRECTED EDGE SIMILAR_TO(FROM Case, TO PriorCase, score DOUBLE);
    ADD DIRECTED EDGE CITES(FROM Decision, TO PolicyDoc);
    ADD DIRECTED EDGE MATCHES_TYPOLOGY(FROM Case, TO TypologyDoc, confidence DOUBLE);
}
RUN SCHEMA_CHANGE JOB change_schema_for_fraud_graph
